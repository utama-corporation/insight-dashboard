# Koneksi database per Sistem (akun read-only, mis. #YOUR_READ_ONLY_USER).
# Nama variabel: <SISTEM>_DB_SERVER / _DB_USER / _DB_PASSWORD — database
# diambil dari reports.yaml.
WPS_DB_SERVER=#YOUR_SERVER
WPS_DB_USER=#YOUR_READ_ONLY_USER
WPS_DB_PASSWORD=
PPS_DB_SERVER=#YOUR_SERVER
PPS_DB_USER=#YOUR_READ_ONLY_USER
PPS_DB_PASSWORD=
PORT=3001
