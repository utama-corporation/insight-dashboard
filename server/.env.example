# Koneksi database per Sistem — isi kredensial di .env (jangan pernah di-commit)
# Sistem diambil dari reports.yaml; tambahkan blok per Sistem dengan pola berikut:

# SYSTEM 1 (WPS)
WPS_DB_SERVER=#YOUR_SERVER
WPS_DB_USER=#YOUR_READ_ONLY_USER
WPS_DB_PASSWORD=#YOUR_PASSWORD

# SYSTEM 2 (PPS)
PPS_DB_SERVER=#YOUR_SERVER
PPS_DB_USER=#YOUR_READ_ONLY_USER
PPS_DB_PASSWORD=#YOUR_PASSWORD

PORT=#YOUR_PORT
# Origin klien yang diizinkan (default http://localhost:5173)
# CORS_ORIGIN=#YOUR_CLIENT_ORIGIN
