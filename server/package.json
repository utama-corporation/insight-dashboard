{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && node --watch --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "validate": "node --env-file-if-exists=.env scripts/validate-whitelist.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mssql": "^11.0.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/mssql": "^9.1.7",
    "@types/node": "^25.6.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.4"
  }
}
